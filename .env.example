# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.zaiphr.in

# ── Supabase (Project Settings → API) ────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # "anon" / publishable key — safe in the browser (used for magic-link sign-in)
SUPABASE_SERVICE_ROLE_KEY=              # "service_role" / secret key — SERVER ONLY, never expose

# ── Email: Resend ────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Zaiphr Labs <shyam@zaiphr.in>"   # must be on your verified domain
LEAD_NOTIFY_EMAIL=shyam@zaiphr.in            # where new-lead alerts go

# ── Admin dashboard (/admin) ─────────────────────────
ADMIN_PASSWORD=                         # 8+ characters; changing it signs everyone out

# ── Optional ─────────────────────────────────────────
IP_HASH_SALT=                           # random string used to hash IPs for rate limiting

# ── AI: Anthropic Claude (Phases 5, 6, 8) ────────────
ANTHROPIC_API_KEY=
STACK_FINDER_MODEL=opus                 # optional: opus (best) | sonnet (≈half the cost) | haiku (cheapest)
STACK_FINDER_EFFORT=low                 # optional: low (fastest, cheapest) | medium | high

# ── AI News (Phase 6) ────────────────────────────────
CRON_SECRET=                            # 16+ random characters; Vercel Cron sends it to /api/cron/news
CHAT_MODEL=sonnet                       # optional: sonnet (default) | haiku (cheapest) | opus — website chat assistant
NEWS_MODEL=sonnet                       # optional: sonnet (default) | opus | haiku — writes the daily brief

# ── Analytics (Phase 9) ──────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
